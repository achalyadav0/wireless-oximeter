# Application configuration

DATABASE_URL=postgresql://oximeter:oximeter_dev_password@localhost:5432/wireless_oximeter
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
# MQTT_VITALS_TOPIC=oximeter/+/ppg
# Use 0.0.0.0 on the Raspberry Pi so the dashboard is reachable on the LAN
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Set to 0 to stop run.py opening the dashboard in a browser
OPEN_BROWSER=1
